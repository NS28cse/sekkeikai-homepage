{
  "name": "sekkeikai-homepage-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens",
    "build": "astro build",
    "preview": "astro preview --ignore-lock",
    "check": "npm run tokens && astro check",
    "format": "prettier --write .",
    "check:sources": "node scripts/check-figure-sources.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}

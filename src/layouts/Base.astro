---
// 全ページ共通の枠（<head>、ヘッダー、フッター）
import "../styles/global.css";
import SocialLinks from "../components/SocialLinks.astro";
import { getSiteLinks } from "../lib/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // true にすると、ヘッダーの下に「どこまで読んだか」の細い線を出す（長文のページ用）
  progress?: boolean;
}

const { title, description, noindex = false, progress = false } = Astro.props;
const fullTitle = title === "設計会" ? "設計会 | 岡山県立大学 公認サークル" : `${title} | 設計会`;
// mobile: false の項目は、スマホ幅ではヘッダーに出さない（フッターには全部出る）
const nav = [
  { href: "/#place", label: "設計会とは", mobile: false },
  { href: "/design/", label: "設計を知る", mobile: true },
  { href: "/news/", label: "お知らせ", mobile: false },
  { href: "/#join", label: "入部", mobile: true },
];
// Discord・TimeTree・メール（src/content/site/links.yaml）
const contacts = await getSiteLinks();
const hasContacts = contacts.some((c) => c.href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600&family=Zen+Kaku+Gothic+New:wght@500;700;900&family=JetBrains+Mono:wght@500&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:p-2"
    >
      本文へスキップ
    </a>
    <header class="sticky top-0 z-40 border-b border-grid bg-paper/85 backdrop-blur">
      {progress && <div class="absolute -bottom-px left-0 h-0.5 w-0 bg-accent" data-progress aria-hidden="true" />}
      <div class="container-page flex h-14 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-widest">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="1" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <path d="M1 11h20M11 1v20" stroke="var(--color-accent)" stroke-width="2"></path>
          </svg>
          設計会
        </a>
        <div class="flex items-center gap-3 sm:gap-6">
          <nav aria-label="メインメニュー">
            <ul class="flex gap-4 text-sm sm:gap-6">
              {nav.map((item) => (
                <li class:list={[!item.mobile && "hidden md:block"]}>
                  <a href={item.href} class="hover:text-link">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {hasContacts && <span class="hidden h-5 w-px bg-grid sm:block" aria-hidden="true" />}
          <SocialLinks />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-grid bg-paper-muted py-12 text-sm text-muted">
      <div class="container-page flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="font-display text-lg font-bold tracking-widest text-ink">設計会</p>
          <p class="mt-1">岡山県立大学 公認サークル</p>
          <!-- 連絡先。links.yaml が空の項目は「準備中」と出す -->
          <ul class="mt-4 space-y-1">
            {contacts.map((c) => (
              <li>
                {c.href ? (
                  <a
                    href={c.href}
                    class="underline underline-offset-4 hover:text-ink"
                    rel={c.external ? "noopener" : undefined}
                    target={c.external ? "_blank" : undefined}
                  >
                    {c.action}
                    {c.external && <span aria-hidden="true"> ↗</span>}
                  </a>
                ) : (
                  <span class="text-muted/70">{c.name}（準備中）</span>
                )}
              </li>
            ))}
          </ul>
        </div>
        <nav aria-label="サイト内のページ">
          <ul class="grid grid-cols-2 gap-x-10 gap-y-2">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="container-page mt-10 text-xs">© 設計会（岡山県立大学）</p>
    </footer>

    <script>
      import { initMotion } from "../scripts/motion";
      import { initReading } from "../scripts/reading";
      initMotion();
      initReading();
    </script>
  </body>
</html>

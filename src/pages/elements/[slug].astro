---
// 設計の要素のページ（/elements/〇〇/）。中身は src/content/elements/〇〇.yaml。
// 広い画面では左に目次、本文の右に注を出す。
import { getCollection, getEntries } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/Blocks.astro";
import Illustration from "../../components/Illustration.astro";
import { numberChapters } from "../../lib/blocks";

export async function getStaticPaths() {
  const elements = (await getCollection("elements")).sort((a, b) => a.data.order - b.data.order);
  return elements.map((element, i) => ({
    params: { slug: element.id },
    props: { element, prev: elements[i - 1], next: elements[i + 1], total: elements.length },
  }));
}

interface Props {
  element: CollectionEntry<"elements">;
  prev?: CollectionEntry<"elements">;
  next?: CollectionEntry<"elements">;
  total: number;
}

const { element, prev, next, total } = Astro.props;
const { title, en, order, question, summary, lead, hero, chapters, references } = element.data;
const related = await getEntries(element.data.related);
const numbered = numberChapters(chapters);

// 章の種類ごとの見出しの上の小さなラベル
const kindLabel = {
  concept: "考え方",
  relation: "設計との関係",
  method: "設計での使い方",
  history: "歴史",
  now: "いま",
  activity: "設計会では",
} as const;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title={`${title}（設計の要素 E${order}）`} description={summary} progress>
  <header class="bg-blueprint-grid border-b border-grid">
    <div class="container-page py-16 sm:py-24">
      <p class="annotation text-muted">
        <a href="/elements/" class="underline hover:text-investor">
          設計の要素
        </a>{" "}
        / E{order} of {total}
      </p>
      <div class="mt-6 flex items-end gap-4 sm:gap-5">
        <span class="font-mono text-5xl leading-none text-investor/25 sm:text-8xl" aria-hidden="true">
          {pad(order)}
        </span>
        <div class="min-w-0">
          <p class="annotation text-investor">{en}</p>
          <h1 class="text-3xl font-black sm:text-6xl">{title}</h1>
        </div>
      </div>
      <p class="mt-8 font-serif text-xl font-semibold sm:text-2xl">「{question}」</p>
      <p class="longform mt-6 max-w-[36em] text-ink/85">{lead}</p>
    </div>
  </header>

  <div class="container-page py-14 xl:grid xl:grid-cols-[11rem_minmax(0,1fr)] xl:gap-12" data-progress-target>
    <nav aria-label="このページの目次" class="hidden xl:block" data-toc>
      <div class="sticky top-24">
        <p class="annotation mb-3 text-muted">Contents</p>
        <ol class="space-y-1 text-sm">
          {chapters.map((c, i) => (
            <li>
              <a href={`#${c.kind}`} class="toc-link block border-l-2 border-grid py-1 pl-3 text-muted hover:text-ink">
                <span class="font-mono text-xs text-investor">{pad(i + 1)}</span> {kindLabel[c.kind]}
              </a>
            </li>
          ))}
          <li>
            <a href="#references" class="toc-link block border-l-2 border-grid py-1 pl-3 text-muted hover:text-ink">
              参考文献
            </a>
          </li>
        </ol>
        <a href="/#essay" class="mt-8 block text-xs text-muted underline hover:text-investor">
          ← 設計論に戻る
        </a>
      </div>
    </nav>

    <article class="max-w-[57rem]">
      {hero && <Illustration {...hero} />}
      <div class="longform">
        {numbered.map((chapter, i) => (
          <section
            id={chapter.kind}
            class="scroll-mt-20 pt-10 first:pt-0"
            aria-labelledby={`${chapter.kind}-title`}
            data-toc-section
          >
            <p class="annotation text-investor" data-reveal>
              {pad(i + 1)} — {kindLabel[chapter.kind]}
            </p>
            <h2
              id={`${chapter.kind}-title`}
              class="mt-2 max-w-[36em] text-2xl leading-snug font-bold sm:text-3xl"
              data-reveal
            >
              {chapter.heading}
            </h2>
            <Blocks blocks={chapter.numbered} />
          </section>
        ))}
      </div>

      <section
        id="references"
        class="scroll-mt-20 mt-20 border-t border-grid pt-10"
        aria-labelledby="references-title"
        data-toc-section
      >
        <h2 id="references-title" class="text-2xl font-bold">
          参考文献
        </h2>
        <ol class="mt-6 space-y-2 text-sm text-ink/85">
          {references.map((r, i) => (
            <li class="grid grid-cols-[2.5rem_1fr]">
              <span class="font-mono text-muted">[{i + 1}]</span>
              <span>
                {r.text}
                {r.url && (
                  <>
                    {" "}
                    <a href={r.url} class="break-all text-investor underline" rel="noopener">
                      {r.url}
                    </a>
                  </>
                )}
              </span>
            </li>
          ))}
        </ol>
      </section>

      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-title">
          <h2 id="related-title" class="text-2xl font-bold">
            あわせて読む
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {related.map((r) => (
              <li>
                <a
                  href={`/elements/${r.id}/`}
                  class="block h-full rounded-card border border-grid p-5 transition hover:border-investor"
                >
                  <p class="annotation text-investor">
                    E{r.data.order} / {r.data.en}
                  </p>
                  <p class="mt-1 font-display text-xl font-bold">{r.data.title}</p>
                  <p class="mt-2 text-sm text-muted">{r.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>

  <nav aria-label="前後の要素" class="border-t border-grid">
    <div class="container-page grid gap-4 py-10 sm:grid-cols-3 sm:items-center">
      <div>
        {prev && (
          <a href={`/elements/${prev.id}/`} class="group block">
            <span class="annotation text-muted">← E{prev.data.order}</span>
            <span class="block font-display text-lg font-bold group-hover:text-investor">{prev.data.title}</span>
          </a>
        )}
      </div>
      <a href="/#essay" class="text-center text-sm text-muted underline hover:text-investor">
        設計論（トップページ）に戻る
      </a>
      <div class="sm:text-right">
        {next && (
          <a href={`/elements/${next.id}/`} class="group block">
            <span class="annotation text-muted">E{next.data.order} →</span>
            <span class="block font-display text-lg font-bold group-hover:text-investor">{next.data.title}</span>
          </a>
        )}
      </div>
    </div>
  </nav>
</Base>

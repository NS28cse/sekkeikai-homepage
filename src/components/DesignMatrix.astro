---
// 設計の地図。横に「工程（設計のプロセス）」、縦に「どの工程にも通じる視点」を並べ、
// 交わるところに、その工程でその視点をどう使うかを書く。設計が一つの技術ではないことを一枚で見せる。
// 工程の見出しは設計のプロセスのページの各工程へ、視点の見出しはそれぞれのページへリンクする。
import { getEntries, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  steps: { title: string; sub: string }[];
  lenses: { design: { collection: "design"; id: string }; cells: string[] }[];
}

const { steps, lenses } = Astro.props;
const process = await getEntry("design", "process");
const lensEntries = (await getEntries(lenses.map((l) => l.design))) as CollectionEntry<"design">[];
const rows = lenses.map((l, i) => ({ entry: lensEntries[i], cells: l.cells }));
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="surface rounded-card border border-grid bg-paper" data-reveal>
  <!-- 広い画面：表 -->
  <div class="hidden md:block">
    <div class="grid" style={`grid-template-columns: 11rem repeat(${steps.length}, minmax(0, 1fr));`}>
      <div class="flex items-end border-b border-grid p-4">
        <p class="annotation text-muted">視点 ↓ / 工程 →</p>
      </div>
      {steps.map((s, i) => (
        <a
          href={`/design/process/#step-${i + 1}`}
          class="group relative border-b border-l border-grid p-4 transition hover:bg-paper-muted"
        >
          <p class="font-mono text-xs text-proposer-strong">{pad(i + 1)}</p>
          <p class="mt-1 font-display font-bold group-hover:text-investor">{s.title}</p>
          <p class="text-xs text-muted">{s.sub}</p>
          {i < steps.length - 1 && (
            <span class="absolute top-1/2 -right-2 z-10 -translate-y-1/2 text-xs text-muted" aria-hidden="true">
              ▶
            </span>
          )}
        </a>
      ))}
      {rows.map((row, r) => (
        <>
          <a
            href={`/design/${row.entry.id}/`}
            class:list={["group p-4 transition hover:bg-paper-muted", r < rows.length - 1 && "border-b border-grid"]}
          >
            <p class="annotation text-investor">{row.entry.data.en}</p>
            <p class="mt-1 font-display text-lg leading-snug font-bold group-hover:text-investor">
              {row.entry.data.short}
            </p>
            <p class="text-xs text-muted">{row.entry.data.title} →</p>
          </a>
          {row.cells.map((cell) => (
            <div class:list={["border-l border-grid p-4 text-sm leading-relaxed", r < rows.length - 1 && "border-b"]}>
              {cell}
            </div>
          ))}
        </>
      ))}
    </div>
  </div>

  <!-- スマホ：視点ごとに工程を縦に並べる -->
  <div class="divide-y divide-grid md:hidden">
    {rows.map((row) => (
      <div class="p-5">
        <a href={`/design/${row.entry.id}/`} class="block">
          <p class="annotation text-investor">{row.entry.data.en}</p>
          <p class="mt-1 font-display text-lg font-bold">{row.entry.data.short} →</p>
        </a>
        <ol class="mt-3 space-y-2 text-sm">
          {row.cells.map((cell, i) => (
            <li class="grid grid-cols-[6.5rem_1fr] gap-3">
              <span class="text-muted">
                <span class="font-mono text-xs text-proposer-strong">{pad(i + 1)}</span> {steps[i].title}
              </span>
              <span>{cell}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</div>

<p class="mt-4 text-sm text-muted">
  工程の流れそのものは
  <a href="/design/process/" class="font-bold text-investor underline underline-offset-4">
    {process?.data.title ?? "設計のプロセス"}
  </a>
  のページで、工程ごとの手法とあわせて解説しています。
</p>

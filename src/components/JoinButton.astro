---
// 「入部」ボタン。押すと、入部フォーム(Microsoft Forms)が新しいタブで開く。
// ヘッダー・トップの上部・入部の章で同じものを使い、文言と行き先をそろえる。
// 行き先は src/content/pages/home.yaml の join の formUrl。空の間は、押せない見た目の「入部」になる。
//   size … sm(ヘッダー) / md(トップの上部) / lg(入部の章)
//   tone … dark(明るい背景の上。黒いボタン) / light(暗い背景の上。白いボタン)
import { getJoinFormUrl } from "../lib/site";

interface Props {
  size?: "sm" | "md" | "lg";
  tone?: "dark" | "light";
}

const { size = "md", tone = "dark" } = Astro.props;
const formUrl = await getJoinFormUrl();

const sizeClass = {
  sm: "px-4 py-1.5 text-sm",
  md: "px-7 py-3.5",
  lg: "px-8 py-4",
}[size];
const toneClass = tone === "dark" ? "bg-ink text-paper" : "bg-accent-strong text-paper";
// 押せるときだけ、指を乗せたときに色を変える
const hoverClass = tone === "dark" ? "hover:bg-accent-strong" : "hover:bg-paper hover:text-ink";
---

{formUrl ? (
  <a
    href={formUrl}
    rel="noopener"
    target="_blank"
    class:list={["inline-flex items-center gap-2 rounded-full font-bold transition", sizeClass, toneClass, hoverClass]}
  >
    入部
    <span aria-hidden="true">↗</span>
    <span class="sr-only">(入部フォームが新しいタブで開きます)</span>
  </a>
) : (
  <span
    class:list={["inline-flex cursor-not-allowed items-center rounded-full font-bold opacity-50", sizeClass, toneClass]}
    title="入部フォームは準備中です"
  >
    入部
    <span class="sr-only">(入部フォームは準備中です)</span>
  </span>
)}

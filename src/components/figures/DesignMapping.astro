---
// 公理的設計の 4 つの領域と、蛇口の例で見る「設計マトリクス」。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
}

const domains = [
  { en: "Customer", name: "顧客領域", what: "使い手の要求", ex: "好きな温度と量でお湯を出したい" },
  { en: "Functional", name: "機能領域", what: "機能要求 FR", ex: "FR1 流量を調節する／FR2 温度を調節する" },
  { en: "Physical", name: "物理領域", what: "設計パラメータ DP", ex: "ハンドルやレバーの構造" },
  { en: "Process", name: "プロセス領域", what: "工程変数 PV", ex: "部品のつくり方・組み立て方" },
];

// X … その設計パラメータを動かすと、その機能が変わる
const designs = [
  {
    name: "2ハンドル混合栓",
    dps: ["湯のハンドル", "水のハンドル"],
    matrix: [
      [true, true],
      [true, true],
    ],
    verdict: "連成設計",
    note: "どちらを回しても、量と温度が同時に変わる",
  },
  {
    name: "シングルレバー混合栓",
    dps: ["レバーの上下", "レバーの左右"],
    matrix: [
      [true, false],
      [false, true],
    ],
    verdict: "非連成設計",
    note: "上下で量、左右で温度。ひとつの操作がひとつの機能に対応する",
  },
];
const frs = ["FR1 流量", "FR2 温度"];
---

<FigureFrame
  number={Astro.props.number}
  title="設計は、要求から形への写像"
  caption="上：公理的設計の4つの領域。設計は左から右へ一方向に進むのではなく、機能要求と設計パラメータを行き来しながら（ジグザグに）詳しくなっていく。下：同じ機能要求に対する2つの設計案を、設計マトリクスで比べたもの。"
  source="N. P. Suh, The Principles of Design (1990) をもとに作図"
>
  <ol class="grid gap-3 md:grid-cols-4">
    {domains.map((d, i) => (
      <li class="relative rounded-md border border-grid bg-paper-muted p-4">
        <p class="annotation text-muted">{d.en}</p>
        <p class="mt-1 font-display text-lg font-bold">{d.name}</p>
        <p class="text-sm font-bold text-investor">{d.what}</p>
        <p class="mt-2 text-sm text-ink/80">{d.ex}</p>
        {i < domains.length - 1 && (
          <span
            class="absolute -bottom-3 left-1/2 z-10 -translate-x-1/2 text-muted md:top-1/2 md:-right-3 md:bottom-auto md:left-auto md:translate-x-0 md:-translate-y-1/2"
            aria-hidden="true"
          >
            <span class="md:hidden">↓</span>
            <span class="hidden md:inline">→</span>
          </span>
        )}
      </li>
    ))}
  </ol>

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {designs.map((d) => (
      <div class="rounded-md border border-grid p-4">
        <p class="font-display font-bold">{d.name}</p>
        <table class="mt-3 w-full border-collapse text-center text-sm">
          <caption class="sr-only">{d.name}の設計マトリクス</caption>
          <thead>
            <tr>
              <td />
              {d.dps.map((dp) => (
                <th scope="col" class="px-2 pb-2 font-normal text-muted">
                  {dp}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {frs.map((fr, r) => (
              <tr>
                <th scope="row" class="pr-2 text-left font-normal text-muted">
                  {fr}
                </th>
                {d.matrix[r].map((x) => (
                  <td class="border border-grid py-2 font-mono text-lg">
                    {x ? <span class="font-bold text-investor">X</span> : <span class="text-muted/60">0</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-3 text-sm">
          <span
            class:list={[
              "mr-2 rounded px-2 py-0.5 text-xs font-bold text-white",
              d.matrix[0][1] ? "bg-proposer-strong" : "bg-partner",
            ]}
          >
            {d.verdict}
          </span>
          {d.note}
        </p>
      </div>
    ))}
  </div>
</FigureFrame>

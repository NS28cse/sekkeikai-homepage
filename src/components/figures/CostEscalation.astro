---
// 要求の誤りを直すコストが、工程が進むほどどれだけ増えるか（NASA の見積もり）。横軸は対数目盛。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
}

// Stecklein ほか (2004) の結果。幅は推定方法による違い
const phases = [
  { label: "要求", min: 1, max: 1 },
  { label: "設計", min: 3, max: 8 },
  { label: "製造", min: 7, max: 16 },
  { label: "統合・試験", min: 21, max: 78 },
  { label: "運用", min: 29, max: 1500, more: true },
];

const left = 120;
const width = 480;
const maxValue = 2000;
const x = (v: number) => left + (Math.log10(v) / Math.log10(maxValue)) * width;
const rowY = (i: number) => 34 + i * 46;
const ticks = [1, 10, 100, 1000];
const fmt = (v: number) => v.toLocaleString("ja-JP");
---

<FigureFrame
  number={Astro.props.number}
  title="誤りは、見つけるのが遅いほど高くつく"
  caption="要求の段階で紛れ込んだ誤りを、どの工程で見つけて直すかによる修正コストの見積もり。要求の段階で直すコストを1としたときの倍率で、横軸は対数目盛（1目盛りで10倍）。帯の幅は推定方法による違い。"
  source="J. M. Stecklein ほか, Error Cost Escalation Through the Project Life Cycle, NASA Johnson Space Center (2004)"
  scroll
>
  <svg
    viewBox="0 0 640 290"
    class="w-full"
    role="img"
    aria-label="修正コストの倍率。要求1倍、設計3〜8倍、製造7〜16倍、統合・試験21〜78倍、運用29〜1500倍以上。"
  >
    <g font-family="var(--font-mono)" font-size="13" fill="var(--color-muted)">
      {ticks.map((t) => (
        <g>
          <line x1={x(t)} x2={x(t)} y1="16" y2="250" stroke="var(--color-grid)" stroke-dasharray="3 4" />
          <text x={x(t)} y="272" text-anchor="middle">
            ×{fmt(t)}
          </text>
        </g>
      ))}
    </g>
    {phases.map((p, i) => {
      const y = rowY(i);
      const x1 = x(p.min);
      const x2 = x(p.max);
      const inside = x2 - x1 > 200;
      const label = p.min === p.max ? `×${p.min}` : `×${fmt(p.min)}〜${fmt(p.max)}${p.more ? " 以上" : ""}`;
      return (
        <g>
          <text x={left - 16} y={y + 5} text-anchor="end" font-size="16" font-weight="700" fill="var(--color-ink)">
            {p.label}
          </text>
          {p.min === p.max ? (
            <circle cx={x1} cy={y} r="7" fill="var(--color-partner)" />
          ) : (
            <rect
              x={x1}
              y={y - 11}
              width={x2 - x1}
              height="22"
              rx="3"
              fill={i >= 3 ? "var(--color-proposer-strong)" : "var(--color-investor)"}
              fill-opacity={i >= 3 ? 0.9 : 0.75}
            />
          )}
          {p.more && <path d={`M${x2} ${y - 11} l10 11 l-10 11 z`} fill="var(--color-proposer-strong)" />}
          <text
            x={inside ? x1 + 10 : x2 + 12}
            y={y + 5}
            font-family="var(--font-mono)"
            font-size="14"
            fill={inside ? "white" : "var(--color-ink)"}
          >
            {label}
          </text>
        </g>
      );
    })}
    <path data-draw d={`M${left} 250 H${left + width}`} stroke="var(--color-ink)" stroke-width="1.5" fill="none" />
  </svg>
</FigureFrame>

---
// Discord・TimeTree・メールのアイコンリンク（ヘッダーで使う）。
// URL は src/content/site/links.yaml。空の項目は出さない。
// Discord の形は Simple Icons（CC0）のもの。カレンダーと封筒は、このサイトで描いた単純な形。
import { getSiteLinks } from "../lib/site";

interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
const links = (await getSiteLinks()).filter((l) => l.href);
---

{links.length > 0 && (
  <ul class="flex items-center gap-1">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          class="flex h-9 w-9 items-center justify-center rounded-full text-ink/75 transition hover:bg-ink hover:text-paper"
          rel={l.external ? "noopener" : undefined}
          target={l.external ? "_blank" : undefined}
          aria-label={l.external ? `${l.name}（新しいタブで開く）` : l.name}
          title={l.name}
        >
          <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={l.icon} />
          </svg>
        </a>
      </li>
    ))}
  </ul>
)}

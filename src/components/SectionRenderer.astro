---
// pages/*.yaml の sections を上から順に描画する。
// 物語の章（statement / figure / map / tags / cards）には、上から 01, 02… と番号を振る。
// 新しい種類のセクションを足すときは：
//   1. src/components/sections/ にコンポーネントを作る
//   2. src/content.config.ts の section に型を足す
//   3. ここの map に登録する（章として番号を付けるなら storyTypes にも足す）
//   4. 本番（sekkeikai-opu）に移すときに、public/admin/config.yml の sections.types に入力欄を足す
import type { Section } from "../content.config";
import Hero from "./sections/Hero.astro";
import Statement from "./sections/Statement.astro";
import FigureSection from "./sections/FigureSection.astro";
import Map from "./sections/Map.astro";
import Tags from "./sections/Tags.astro";
import Cards from "./sections/Cards.astro";
import Join from "./sections/Join.astro";
import Info from "./sections/Info.astro";
import News from "./sections/News.astro";

interface Props {
  sections: Section[];
}

const components = {
  hero: Hero,
  statement: Statement,
  figure: FigureSection,
  map: Map,
  tags: Tags,
  cards: Cards,
  join: Join,
  info: Info,
  news: News,
} as const;
const storyTypes: Section["type"][] = ["statement", "figure", "map", "tags", "cards"];

const { sections } = Astro.props;
let count = 0;
const numbered = sections.map((section) => ({
  section,
  number: storyTypes.includes(section.type) ? String(++count).padStart(2, "0") : undefined,
}));
---

{numbered.map(({ section, number }) => {
  const Component = components[section.type] as any;
  return <Component {...section} number={number} />;
})}

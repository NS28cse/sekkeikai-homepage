---
// 言葉を札（タグ）にして並べる章。「設計の対象は『もの』だけではない」などに使う。
import StoryShell from "../StoryShell.astro";

interface Props {
  number: string;
  tone?: "light" | "dark";
  eyebrow: string;
  title: string;
  lead: string;
  body: string[];
  tags: string[];
  illustration?: { id: string; caption: string; alt: string; src?: string; ratio?: "21:9" | "16:9" | "4:3" | "1:1" };
  link?: { label: string; href: string };
}

const { tags, ...story } = Astro.props;
const dark = story.tone === "dark";
---

<StoryShell {...story}>
  <p class:list={["annotation mb-4", dark ? "text-white/60" : "text-muted"]} data-reveal>
    設計できるものの例
  </p>
  <ul class="flex flex-wrap gap-2.5" data-reveal>
    {tags.map((tag, i) => (
      <li
        class:list={[
          "rounded-full border px-4 py-2 text-sm font-bold sm:text-base",
          i % 4 === 0
            ? "border-proposer-strong text-proposer-strong"
            : dark
              ? "border-white/30 text-white"
              : "border-grid text-ink",
        ]}
      >
        {tag}
      </li>
    ))}
  </ul>
</StoryShell>

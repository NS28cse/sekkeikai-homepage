---
// 設計の地図の章。見出しを上に置き、地図（工程 × 視点の表）を横いっぱいに出す。
import StoryShell from "../StoryShell.astro";
import DesignMatrix from "../DesignMatrix.astro";

interface Props {
  number: string;
  tone?: "light" | "dark";
  eyebrow: string;
  title: string;
  lead: string;
  body: string[];
  steps: { title: string; sub: string }[];
  lenses: { design: { collection: "design"; id: string }; cells: string[] }[];
  illustration?: { id: string; caption: string; alt: string; src?: string; ratio?: "21:9" | "16:9" | "4:3" | "1:1" };
  link?: { label: string; href: string };
}

const { steps, lenses, ...story } = Astro.props;
---

<StoryShell id="map" {...story} wide>
  <DesignMatrix steps={steps} lenses={lenses} />
</StoryShell>

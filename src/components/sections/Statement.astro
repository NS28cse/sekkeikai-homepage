---
// 「思いつき」と「よく考えられた設計」を、一行ずつ対にして比べる章。
import StoryShell from "../StoryShell.astro";

interface Props {
  number: string;
  tone?: "light" | "dark";
  eyebrow: string;
  title: string;
  lead: string;
  body: string[];
  compare: { fromLabel: string; toLabel: string; rows: { from: string; to: string }[] };
  illustration?: { id: string; caption: string; alt: string; src?: string; ratio?: "21:9" | "16:9" | "4:3" | "1:1" };
  link?: { label: string; href: string };
}

const { compare, ...story } = Astro.props;
---

<StoryShell id="why" {...story}>
  <div class="surface overflow-hidden rounded-card border border-grid bg-paper" data-reveal>
    <div class="grid grid-cols-[1fr_auto_1fr] border-b border-grid bg-paper-muted px-5 py-3 text-xs sm:px-6">
      <p class="annotation text-muted">{compare.fromLabel}</p>
      <span></span>
      <p class="annotation text-proposer-strong">{compare.toLabel}</p>
    </div>
    <ul>
      {compare.rows.map((row) => (
        <li class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 border-b border-grid px-5 py-5 last:border-b-0 sm:px-6">
          <span class="text-muted line-through decoration-muted/40">{row.from}</span>
          <span class="text-proposer-strong" aria-label="から">
            →
          </span>
          <span class="font-bold">{row.to}</span>
        </li>
      ))}
    </ul>
  </div>
</StoryShell>

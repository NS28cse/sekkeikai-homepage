---
// トップページの長文「設計論」。章ごとに段落・図・イラストを並べ、注は本文の右（スマホでは段落の下）に出す。
// 本文中の [[要素]] は、設計の要素のページへのリンクになる。
import type { Block } from "../../content.config";
import { numberChapters, readingMinutes } from "../../lib/blocks";
import { plainText } from "../../lib/inline";
import Blocks from "../Blocks.astro";

interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  lead: string;
  chapters: { heading: string; blocks: Block[] }[];
}

const { eyebrow, title, lead, chapters } = Astro.props;
const numbered = numberChapters(chapters);
const texts = chapters.flatMap((c) => c.blocks.flatMap((b) => (b.type === "p" ? [plainText(b.text)] : [])));
const minutes = readingMinutes(texts);
const chapterId = (i: number) => `essay-${i + 1}`;
---

<section
  id="essay"
  class="border-b border-grid bg-paper py-20 sm:py-28"
  aria-labelledby="essay-title"
  data-progress-target
>
  <div class="container-page">
    <header class="max-w-[57rem]">
      {eyebrow && <p class="annotation mb-3 text-muted">{eyebrow}</p>}
      <h2 id="essay-title" class="text-3xl font-bold sm:text-5xl" data-reveal>
        {title}
      </h2>
      <p class="longform mt-8 max-w-[36em] text-ink/85" data-reveal>
        {lead}
      </p>
      <p class="annotation mt-6 text-muted normal-case">
        全 {chapters.length} 章 ・ 約 {minutes} 分で読めます
      </p>
      <nav aria-label="設計論の目次" class="mt-8 rounded-card border border-grid bg-paper-muted p-5 sm:p-6" data-toc>
        <p class="annotation mb-3 text-muted">Contents</p>
        <ol class="grid gap-x-8 gap-y-2 text-[0.95rem] sm:grid-cols-2">
          {chapters.map((c, i) => (
            <li>
              <a
                href={`#${chapterId(i)}`}
                class="toc-link flex gap-3 border-l-2 border-transparent pl-2 text-ink/75 hover:text-investor"
              >
                <span class="font-mono text-investor">§{String(i + 1).padStart(2, "0")}</span>
                <span>{c.heading}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <div class="longform mt-16 max-w-[57rem]">
      {numbered.map((chapter, i) => (
        <section
          id={chapterId(i)}
          class="scroll-mt-20 pt-12"
          aria-labelledby={`${chapterId(i)}-title`}
          data-toc-section
        >
          <p class="annotation text-investor" data-reveal>
            § {String(i + 1).padStart(2, "0")}
          </p>
          <h3
            id={`${chapterId(i)}-title`}
            class="mt-2 max-w-[36em] font-display text-2xl leading-snug font-bold tracking-wide sm:text-3xl"
            data-reveal
          >
            {chapter.heading}
          </h3>
          <Blocks blocks={chapter.numbered} />
        </section>
      ))}
    </div>
  </div>
</section>

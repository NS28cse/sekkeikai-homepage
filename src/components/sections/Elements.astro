---
// 設計の要素の一覧。広い画面では「設計」を中心にした地図、その下にカードを並べる。
import { getCollection } from "astro:content";
import SectionShell from "../SectionShell.astro";
import ElementsMap from "../ElementsMap.astro";

interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  body?: string;
}

const { tone, eyebrow, title, body } = Astro.props;
const elements = (await getCollection("elements")).sort((a, b) => a.data.order - b.data.order);
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title} id="elements">
  {body && (
    <p class="max-w-3xl text-lg" data-reveal>
      {body}
    </p>
  )}
  <div class="surface mt-10 hidden rounded-card border border-grid bg-paper p-6 md:block" data-reveal>
    <ElementsMap />
  </div>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {elements.map((el, i) => (
      <li data-reveal data-reveal-delay={String((i % 3) * 0.08)}>
        <a
          href={`/elements/${el.id}/`}
          class="surface group flex h-full flex-col rounded-card border border-grid bg-paper p-6 transition hover:border-investor"
        >
          <p class="annotation text-investor">
            E{el.data.order} / {el.data.en}
          </p>
          <h3 class="mt-1 text-2xl font-bold">{el.data.title}</h3>
          <p class="mt-2 font-serif text-[0.95rem] text-ink/80">「{el.data.question}」</p>
          <p class="mt-3 flex-1 text-sm text-muted">{el.data.summary}</p>
          <p class="mt-4 text-sm font-bold text-investor">
            詳しく読む{" "}
            <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </p>
        </a>
      </li>
    ))}
  </ul>
</SectionShell>

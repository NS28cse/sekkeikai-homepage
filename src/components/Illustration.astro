---
// イラストの枠。src（画像のパス）があれば画像を、まだ無ければ「制作中」の枠を出す。
// 何を描くかの指定は docs/illustrations.md に番号（id）ごとに書いてある。
interface Props {
  id: string;
  caption: string;
  alt: string;
  src?: string;
  ratio?: "21:9" | "16:9" | "4:3" | "1:1";
}

const { id, caption, alt, src, ratio = "16:9" } = Astro.props;
const aspect = { "21:9": "aspect-[21/9]", "16:9": "aspect-video", "4:3": "aspect-[4/3]", "1:1": "aspect-square" }[
  ratio
];
---

<figure class="my-12 font-sans" data-reveal>
  {src ? (
    <img src={src} alt={alt} class:list={["w-full rounded-card object-cover", aspect]} loading="lazy" />
  ) : (
    <div
      class:list={[
        "bg-blueprint-grid flex w-full flex-col items-center justify-center gap-2 rounded-card border-2 border-dashed border-muted/50 bg-paper-muted p-6 text-center",
        aspect,
      ]}
      role="img"
      aria-label={`イラスト（制作中）：${alt}`}
    >
      <span class="annotation text-muted">Illustration / 制作中</span>
      <span class="font-mono text-2xl text-ink sm:text-3xl">{id}</span>
      <span class="max-w-md text-sm text-muted">{alt}</span>
    </div>
  )}
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>

---
// 長文のブロック（段落・図・イラスト・手順・年表）を上から順に表示する。
// 番号（注・図）は src/lib/blocks.ts の numberChapters で付けたものを使う。
import type { NumberedBlock } from "../lib/blocks";
import InlineText from "./InlineText.astro";
import Figure from "./Figure.astro";
import Illustration from "./Illustration.astro";

interface Props {
  blocks: NumberedBlock[];
}

const { blocks } = Astro.props;
---

{blocks.map(({ block, note, figure }) => {
  if (block.type === "p") {
    return (
      <div class="longform-row">
        <p>
          <InlineText text={block.text} />
          {note && (
            <a href={`#note-${note}`} id={`ref-${note}`} class="note-ref" aria-label={`注 ${note}`}>
              {note}
            </a>
          )}
        </p>
        {block.note && (
          <aside class="sidenote" id={`note-${note}`}>
            <span class="annotation mr-1 text-investor">注{note}</span>
            <InlineText text={block.note} />
          </aside>
        )}
      </div>
    );
  }
  if (block.type === "figure") return <Figure name={block.name} number={figure} />;
  if (block.type === "illustration") return <Illustration {...block} />;
  if (block.type === "steps") {
    return (
      <ol class="my-10 grid gap-4 font-sans text-base leading-relaxed sm:grid-cols-2">
        {block.items.map((item, i) => (
          <li class="rounded-card border border-grid bg-paper p-5" data-reveal>
            <p class="annotation text-proposer-strong">Step {String(i + 1).padStart(2, "0")}</p>
            <p class="mt-1 font-display text-lg font-bold">{item.title}</p>
            <p class="mt-2 text-[0.95rem] tracking-normal text-ink/85">
              <InlineText text={item.body} />
            </p>
          </li>
        ))}
      </ol>
    );
  }
  return (
    <ol class="relative my-10 border-l-2 border-grid pl-6 font-sans text-base leading-relaxed sm:ml-28 sm:pl-8">
      {block.items.map((item) => (
        <li class="relative pb-7 last:pb-0" data-reveal>
          <span
            class="absolute top-2.5 -left-[30px] h-2.5 w-2.5 rounded-full border-2 border-investor bg-paper sm:-left-[38px]"
            aria-hidden="true"
          />
          <p class="annotation text-investor sm:absolute sm:top-1 sm:-left-[8.9rem] sm:w-24 sm:text-right">
            {item.year}
          </p>
          <p class="font-display text-lg font-bold">{item.title}</p>
          <p class="mt-1 text-[0.95rem] tracking-normal text-ink/85">
            <InlineText text={item.body} />
          </p>
        </li>
      ))}
    </ol>
  );
})}

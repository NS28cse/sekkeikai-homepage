---
// トップの背景に描く「設計図」（椅子の側面図・寸法線・荷重の矢印）。線は motion.ts の data-draw で描かれていく。
// 大きな画面では右側に大きく、スマホでは見出しの下に小さく出すので、部品にしている。
interface Props {
  class?: string;
  // 見せる範囲。スマホでは図のまわりの余白を切り落として使う
  viewBox?: string;
}

const { class: className, viewBox = "0 0 600 640" } = Astro.props;
---

<svg class={className} viewBox={viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <g fill="none" stroke-width="2" stroke-linecap="round">
    <!-- 椅子の側面図 -->
    <path data-draw d="M210 200 V470" stroke="var(--color-ink)" stroke-opacity="0.55"></path>
    <path data-draw d="M210 340 H400 V470" stroke="var(--color-ink)" stroke-opacity="0.55"></path>
    <path data-draw d="M200 330 H410" stroke="var(--color-ink)" stroke-width="5" stroke-opacity="0.7"></path>
    <path data-draw d="M210 230 Q 230 215 250 230 V300" stroke="var(--color-ink)" stroke-opacity="0.3"></path>
    <!-- 寸法線 -->
    <path data-draw d="M200 520 H410 M200 510 V530 M410 510 V530" stroke="var(--color-link)"></path>
    <path data-draw d="M460 330 V470 M450 330 H470 M450 470 H470" stroke="var(--color-positive)"></path>
    <!-- 力の矢印（荷重） -->
    <path data-draw d="M305 230 V318 M297 306 L305 318 L313 306" stroke="var(--color-accent)" stroke-width="2.5"></path>
    <circle data-draw cx="305" cy="330" r="46" stroke="var(--color-accent)" stroke-dasharray="4 6"></circle>
  </g>
  <g font-family="var(--font-mono)" font-size="14">
    <text x="282" y="550" fill="var(--color-link)">
      W 420
    </text>
    <text x="478" y="405" fill="var(--color-positive)">
      H 450
    </text>
    <text x="318" y="222" fill="var(--color-accent-strong)">
      F = 600 N
    </text>
    <text x="356" y="392" fill="var(--color-muted)">
      FR1 / DP1
    </text>
  </g>
</svg>
